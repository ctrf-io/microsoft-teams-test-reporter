{
	"name": "teams-ctrf",
	"version": "0.0.7-next-6",
	"description": "Send test results messages to Microsoft Teams",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc -p .",
		"all": "npm run lint:check && npm run format:check && npm run test:coverage && npm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome lint --write . --unsafe",
		"lint:check": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check ."
	},
	"bin": {
		"teams-ctrf": "./dist/cli.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ctrf-io/microsoft-teams-test-reporter.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"homepage": "https://ctrf.io",
	"files": [
		"dist/",
		"README.md"
	],
	"author": "Matthew Thomas",
	"license": "MIT",
	"dependencies": {
		"ctrf": "0.2.1",
		"yargs": "18.0.0"
	},
	"devDependencies": {
		"@d2t/vitest-ctrf-json-reporter": "1.3.0",
		"@biomejs/biome": "2.4.16",
		"@types/node": "25.9.2",
		"@types/yargs": "17.0.35",
		"@vitest/coverage-v8": "4.1.8",
		"typescript": "6.0.3",
		"vitest": "4.1.8"
	}
}
